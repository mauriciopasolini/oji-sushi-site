# Supabase (projeto oji-cmv, sa-east-1)
NEXT_PUBLIC_SUPABASE_URL=https://zjmzujzgwgkplghszuyi.supabase.co
# Publishable key (sb_publishable_...) — equivale à antiga "anon key"
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...) — equivale à antiga "service_role". SÓ servidor.
SUPABASE_SERVICE_ROLE_KEY=

# Google Sheets — JSON da conta de serviço, codificado em base64. SÓ servidor.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Segredo do Vercel Cron (string aleatória longa)
CRON_SECRET=

# Conexão Postgres (Session pooler) — só para scripts locais (npm run db:migrate / db:test-rls).
# Connect → Connection String → Session pooler. NÃO configurar na Vercel.
SUPABASE_DB_URL=postgresql://postgres.zjmzujzgwgkplghszuyi:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres
